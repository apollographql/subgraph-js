{
  "name": "@apollo/subgraph-compatibility",
  "version": "1.0.0",
  "private": true,
  "description": "Runs the Apollo Federation subgraph compatibility suite against @apollo/subgraph",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf dist",
    "start": "node dist/index.js",
    "compatibility": "fedtest docker --compose compose.yaml --schema schema.graphql --failOnRequired --failOnWarning",
    "compatibility:local": "fedtest pm2 --endpoint http://localhost:4001 --schema schema.graphql --failOnRequired --failOnWarning"
  },
  "dependencies": {
    "@apollo/server": "^5.0.0",
    "graphql": "^16.11.0",
    "graphql-tag": "^2.12.6"
  },
  "devDependencies": {
    "@apollo/federation-subgraph-compatibility": "3.0.1",
    "@apollo/subgraph": "file:..",
    "@types/node": "^24.13.3",
    "typescript": "^5.7.2"
  }
}
