{
  "name": "@apollo/subgraph",
  "version": "15.0.0-alpha.0",
  "description": "Apollo Federation subgraph utilities built on graphql-js",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "graphql",
    "federation",
    "apollo",
    "subgraph"
  ],
  "author": "Apollo <packages@apollographql.com>",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "workspaces": [
    ".",
    "compatibility"
  ],
  "scripts": {
    "build": "tsc --build tsconfig.json",
    "clean": "rm -rf dist",
    "test": "jest",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "format": "prettier --write \"src/**/*.ts\" \"compatibility/src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"compatibility/src/**/*.ts\"",
    "changeset": "changeset",
    "changeset-version": "changeset version && npm install --package-lock-only",
    "release": "npm run build && changeset publish",
    "prepack": "npm run clean && npm run build"
  },
  "dependencies": {
    "@apollo/cache-control-types": "^1.0.3",
    "@graphql-tools/utils": "^12.0.0"
  },
  "peerDependencies": {
    "graphql": "^16.11.0"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.0",
    "@changesets/cli": "^3.0.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^24.13.3",
    "graphql": "^16.11.0",
    "graphql-tag": "^2.12.7",
    "jest": "^29.7.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
